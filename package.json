{
  "name": "zn-ai-flow",
  "version": "1.0.0",
  "description": "AI 工作流编排平台 — 学习实践项目",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:watch": "turbo build:watch",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "commit": "git-cz --edit $1",
    "commitlint": "commitlint --edit $1",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:staged": "lint-staged"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint"
    ],
    "*.{ts,tsx}": [
      "eslint"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.29.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "commitizen": "4.3.1",
    "cz-git": "1.11.2",
    "eslint": "9.29.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "fast-glob": "3.3.3",
    "globals": "16.2.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.1",
    "turbo": "^2.9.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.34.0"
  }
}